NODE_ENV=production
APP_PORT=3001
APP_NAME=Subscription Monitor API
API_PREFIX=api
APP_FALLBACK_LANGUAGE=zh
APP_HEADER_LANGUAGE=x-custom-lang

PERSISTENCE_DRIVER=prisma

# Generate a URL-safe password with: openssl rand -hex 32
# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
POSTGRES_DB=subscription_monitor
POSTGRES_USER=subscription_app
POSTGRES_PASSWORD=replace_with_64_hex_char_password
DATABASE_URL=postgresql://subscription_app:replace_with_64_hex_char_password@postgres:5432/subscription_monitor?schema=public

BACKEND_DOMAIN=https://api.example.com
FRONTEND_DOMAIN=https://app.example.com

WECHAT_APP_ID=wx639160564da9289a
WECHAT_APP_SECRET=
# Generate a separate session signing key with: openssl rand -hex 32
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800
WECHAT_REMINDER_TEMPLATE_ID=DtXtPe3WigMtfa07tmFI5fkXHVwY1hh5wex7wdLh3to
WECHAT_MESSAGE_STATE=formal
NOTIFICATION_SCHEDULER_ENABLED=true
WECHAT_SUBSCRIPTION_TYPE=long_term
LOCAL_ADMIN_ENABLED=false
MEMBERSHIP_SIMULATION_ENABLED=false

# Personal mini-program virtual payment: live environment only. Keep disabled until deployment acceptance.
WECHAT_VIRTUAL_PAY_ENABLED=false
WECHAT_VIRTUAL_PAY_OFFER_ID=1450679545
WECHAT_VIRTUAL_PAY_APP_KEY=
WECHAT_VIRTUAL_PAY_PRODUCT_ID=lifetime_member
WECHAT_VIRTUAL_PAY_NOTIFY_TOKEN=
WECHAT_VIRTUAL_PAY_ENCODING_AES_KEY=
# Apple IAP has not been activated.
WECHAT_VIRTUAL_PAY_IOS_ENABLED=false
## Immediate Nginx/Docker gateway addresses, e.g. 172.18.0.1/32 (verify on host).
## Requires proxy_set_header X-Real-IP $remote_addr in the API Nginx location.
TRUSTED_PROXY_CIDRS=

# Independent admin login. Keep hash single-quoted when copying into Compose env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
## Daily authenticated-user activity for analytics.
ANALYTICS_COLLECTION_ENABLED=true
## Requires administrator login and enabled virtual payment.
ADMIN_REFUNDS_ENABLED=true
ADMIN_USER_LABELS_ENABLED=true
