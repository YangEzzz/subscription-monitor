<button role="button" tabindex="0" class="renewal-row" bindtap="{{i}}"><view class="date-stamp" aria-hidden="true"><text class="date-stamp-month">{{a}}月</text><text class="date-stamp-day">{{b}}</text></view><view class="renewal-main"><text class="renewal-name">{{c}}</text><text class="renewal-date">{{d}} · {{e}}</text></view><view class="renewal-side"><text class="renewal-price">{{f}}</text><text class="{{['days', h && 'urgent']}}">{{g}}</text></view></button>