<view class="page home-page"><view class="primary-titlebar home-head" style="{{'height:' + a}}"><text class="page-title">续订清单</text></view><text class="home-lead">每一笔续费，都提前心中有数</text><view class="summary-card"><view class="summary-top"><text>未来 30 天预计扣费</text><button role="button" tabindex="0" class="summary-eye" aria-label="显示或隐藏金额" bindtap="{{c}}"><uni-icons wx:if="{{b}}" u-i="e09cc250-0" bind:__l="__l" u-p="{{b}}"/></button></view><text class="summary-amount compact-total">{{d}}</text><view class="summary-meta"><text>共 {{e}} 项</text><view class="divider"></view><text>月均约 {{f}}</text></view></view><view class="overview-metrics"><view class="overview-metric"><text class="overview-metric-label">正在订阅</text><view class="overview-metric-value">{{g}}<text>项服务</text></view></view><view class="overview-metric"><text class="overview-metric-label">7 天内续费</text><view class="overview-metric-value">{{h}}<text>项提醒</text></view></view></view><view wx:if="{{i}}" class="notice-banner" bindtap="{{o}}"><view class="notice-icon"><uni-icons wx:if="{{j}}" u-i="e09cc250-1" bind:__l="__l" u-p="{{j}}"/></view><view class="notice-copy"><text class="notice-title">开启微信续费通知</text><text class="notice-desc">{{k}}</text></view><button role="button" tabindex="0" class="notice-action" disabled="{{m}}" catchtap="{{n}}">{{l}}</button></view><view class="section-card"><view class="section-head"><text class="section-title">即将续费</text><button role="button" tabindex="0" class="text-button" bindtap="{{r}}"> 全部 {{p}} <uni-icons wx:if="{{q}}" u-i="e09cc250-2" bind:__l="__l" u-p="{{q}}"/></button></view><view wx:if="{{s}}" class="group-title"><text>未来 7 天</text><text class="count-dot red">{{t}}</text></view><subscription-row wx:for="{{v}}" wx:for-item="item" wx:key="a" bindtap="{{item.b}}" u-i="{{item.c}}" bind:__l="__l" u-p="{{item.d}}"/><view wx:if="{{w}}" class="group-title second"><text>未来 30 天</text><text class="count-dot orange">{{x}}</text></view><subscription-row wx:for="{{y}}" wx:for-item="item" wx:key="a" bindtap="{{item.b}}" u-i="{{item.c}}" bind:__l="__l" u-p="{{item.d}}"/><view wx:if="{{z}}" class="empty-compact"><text>未来 30 天暂无扣费</text><button role="button" tabindex="0" class="text-button green" bindtap="{{A}}"> 新增订阅 </button></view><button wx:if="{{B}}" role="button" tabindex="0" class="view-more" bindtap="{{D}}"> 查看全部 {{C}} 项 </button></view><view class="section-card reminder-card"><view class="section-head"><text class="section-title">待处理事项</text><text class="section-caption">{{E}} 项</text></view><button wx:for="{{F}}" wx:for-item="reminder" wx:key="i" role="button" tabindex="0" class="reminder-row" bindtap="{{reminder.j}}"><view class="{{['reminder-icon', reminder.c]}}"><uni-icons wx:if="{{reminder.b}}" u-i="{{reminder.a}}" bind:__l="__l" u-p="{{reminder.b}}"/></view><view class="reminder-copy"><text class="reminder-title">{{reminder.d}}</text><text class="reminder-desc">{{reminder.e}}</text></view><uni-icons wx:if="{{reminder.f}}" u-i="{{reminder.g}}" bind:__l="__l" u-p="{{reminder.h}}"/></button></view><button role="button" tabindex="0" class="primary-button home-add" bindtap="{{H}}"><uni-icons wx:if="{{G}}" u-i="e09cc250-7" bind:__l="__l" u-p="{{G}}"/>新增订阅 </button></view>