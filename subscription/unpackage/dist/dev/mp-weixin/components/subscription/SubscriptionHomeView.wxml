<view class="page home-page"><view class="primary-titlebar home-head" style="{{'height:' + a}}"><text class="page-title">续订清单</text></view><text class="home-lead">每一笔续费，都提前心中有数</text><view class="summary-card"><view class="summary-top"><text>未来 30 天预计扣费</text><button class="summary-eye" aria-label="显示或隐藏金额" bindtap="{{c}}"><uni-icons wx:if="{{b}}" u-i="40b3b45b-0" bind:__l="__l" u-p="{{b}}"/></button></view><text class="summary-amount compact-total">{{d}}</text><view class="summary-meta"><text>共 {{e}} 项</text><view class="divider"></view><text>月均约 {{f}}</text></view><view class="summary-spark" aria-hidden="true"><view wx:for="{{g}}" wx:for-item="bar" wx:key="a" class="summary-spark-bar" style="{{'height:' + bar.b}}"></view></view></view><view wx:if="{{h}}" class="notice-banner" bindtap="{{k}}"><view class="notice-icon"><uni-icons wx:if="{{i}}" u-i="40b3b45b-1" bind:__l="__l" u-p="{{i}}"/></view><view class="notice-copy"><text class="notice-title">续费提醒尚未开启</text><text class="notice-desc">点击后申请微信订阅消息授权</text></view><button class="notice-action" catchtap="{{j}}">开启</button></view><view class="section-card"><view class="section-head"><text class="section-title">即将续费</text><button class="text-button" bindtap="{{n}}">全部 {{l}} <uni-icons wx:if="{{m}}" u-i="40b3b45b-2" bind:__l="__l" u-p="{{m}}"/></button></view><view wx:if="{{o}}" class="group-title"><text>未来 7 天</text><text class="count-dot red">{{p}}</text></view><subscription-row wx:for="{{q}}" wx:for-item="item" wx:key="a" bindtap="{{item.b}}" u-i="{{item.c}}" bind:__l="__l" u-p="{{item.d}}"/><view wx:if="{{r}}" class="group-title second"><text>未来 30 天</text><text class="count-dot orange">{{s}}</text></view><subscription-row wx:for="{{t}}" wx:for-item="item" wx:key="a" bindtap="{{item.b}}" u-i="{{item.c}}" bind:__l="__l" u-p="{{item.d}}"/><view wx:if="{{v}}" class="empty-compact"><text>未来 30 天暂无扣费</text><button class="text-button green" bindtap="{{w}}">新增订阅</button></view><button wx:if="{{x}}" class="view-more" bindtap="{{z}}">查看全部 {{y}} 项</button></view><view class="section-card reminder-card"><view class="section-head"><text class="section-title">待处理事项</text><text class="section-caption">{{A}} 项</text></view><view wx:for="{{B}}" wx:for-item="reminder" wx:key="i" class="reminder-row" bindtap="{{reminder.j}}"><view class="{{['reminder-icon', reminder.c]}}"><uni-icons wx:if="{{reminder.b}}" u-i="{{reminder.a}}" bind:__l="__l" u-p="{{reminder.b}}"/></view><view class="reminder-copy"><text class="reminder-title">{{reminder.d}}</text><text class="reminder-desc">{{reminder.e}}</text></view><uni-icons wx:if="{{reminder.f}}" u-i="{{reminder.g}}" bind:__l="__l" u-p="{{reminder.h}}"/></view></view><button class="primary-button home-add" bindtap="{{D}}"><uni-icons wx:if="{{C}}" u-i="40b3b45b-7" bind:__l="__l" u-p="{{C}}"/>新增订阅</button></view>