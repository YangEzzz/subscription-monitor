<view class="page calendar-page"><view class="primary-titlebar" style="{{'height:' + a}}"><text class="page-title">续费日历</text></view><view class="month-nav"><button role="button" tabindex="0" class="month-arrow" bindtap="{{c}}"><uni-icons wx:if="{{b}}" u-i="64d86837-0" bind:__l="__l" u-p="{{b}}"/></button><text class="month-name">{{d}}</text><button role="button" tabindex="0" class="month-arrow" bindtap="{{f}}"><uni-icons wx:if="{{e}}" u-i="64d86837-1" bind:__l="__l" u-p="{{e}}"/></button><button role="button" tabindex="0" class="today-button" bindtap="{{g}}"> 今天 </button></view><view class="calendar-card"><view class="calendar-grid week-grid"><text wx:for="{{h}}" wx:for-item="day" wx:key="b">{{day.a}}</text></view><view class="calendar-grid dates-grid"><button wx:for="{{i}}" wx:for-item="day" wx:key="f" role="button" tabindex="0" class="{{['date-cell', day.g && 'muted', day.h && 'selected', day.i && 'today']}}" bindtap="{{day.j}}"><text class="day-number">{{day.a}}</text><view wx:if="{{day.b}}" class="event-count">{{day.c}}</view><text wx:if="{{day.d}}" class="tiny-price">{{day.e}}</text></button></view></view><view class="calendar-detail"><view class="detail-heading"><view><text class="detail-date">{{j}}</text><text class="detail-week">{{k}}</text></view><text class="detail-total">{{l}} 项 · {{m}}</text></view><view wx:if="{{n}}"><view wx:for="{{o}}" wx:for-item="item" wx:key="g" class="calendar-subscription" bindtap="{{item.h}}"><brand-logo wx:if="{{item.b}}" u-i="{{item.a}}" bind:__l="__l" u-p="{{item.b}}"/><view class="list-main"><text class="list-name">{{item.c}}</text><text class="list-detail">{{item.d}} · {{item.e}}</text></view><text class="item-amount">{{item.f}}</text></view></view><view wx:else class="empty-compact calendar-empty"><text>当天没有续费项目</text><button role="button" tabindex="0" class="text-button green" bindtap="{{p}}"> 添加到这一天 </button></view></view></view>