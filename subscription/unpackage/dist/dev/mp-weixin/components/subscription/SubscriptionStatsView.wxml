<view class="page stats-page"><view class="primary-titlebar" style="{{'height:' + a}}"><text class="page-title">支出统计</text></view><stat-summary-card wx:if="{{d}}" bindcurrencyChange="{{b}}" bindperiodChange="{{c}}" u-i="604188bd-0" bind:__l="__l" u-p="{{d}}"/><view class="chart-card category-chart-card"><view class="card-heading"><text class="section-title">分类构成</text><text>{{e}}</text></view><view class="category-chart-body"><view class="donut" style="{{'background:' + g}}"><view class="donut-hole"><text class="donut-value">{{f}}</text><text class="donut-label">分类占比</text></view></view><view class="legend"><view wx:for="{{h}}" wx:for-item="item" wx:key="e" class="legend-row"><view class="legend-color" style="{{'background-color:' + item.a}}"></view><text class="legend-name">{{item.b}}</text><text class="legend-value">{{item.c}}</text><text class="legend-percent">{{item.d}}%</text></view></view></view></view><view class="trend-card"><view class="trend-head"><view><text class="section-title">支出趋势</text><text class="trend-sub">未来 6 个月预计扣费</text></view><text class="unit-label">币种：{{i}}</text></view><view class="bar-chart"><view wx:for="{{j}}" wx:for-item="bar" wx:key="d" class="bar-column"><text class="bar-value">{{bar.a}}</text><view class="bar-track"><view class="bar-fill" style="{{'height:' + bar.b}}"></view></view><text>{{bar.c}}</text></view></view></view><view class="insight-card"><view class="insight-icon"><uni-icons wx:if="{{k}}" u-i="604188bd-1" bind:__l="__l" u-p="{{k}}"/></view><view><text class="insight-title">年度订阅可重点检查</text><text class="insight-desc">年度订阅单次扣费更高，建议至少提前 14 天确认是否继续使用。</text></view></view></view>