<view class="page stats-page"><view class="primary-titlebar" style="{{'height:' + a}}"><text class="page-title">支出统计</text></view><stat-summary-card wx:if="{{d}}" bindcurrencyChange="{{b}}" bindperiodChange="{{c}}" u-i="1dfe2440-0" bind:__l="__l" u-p="{{d}}"/><empty-state-view wx:if="{{e}}" bindaction="{{f}}" u-i="1dfe2440-1" bind:__l="__l" u-p="{{g}}"/><view wx:if="{{h}}" class="chart-card category-chart-card"><view class="card-heading"><text class="section-title">分类构成</text><text>{{i}}</text></view><view class="category-chart-body"><view class="donut" style="{{'background:' + k}}"><view class="donut-hole"><text class="donut-value">{{j}}</text><text class="donut-label">分类占比</text></view></view><view class="legend"><view wx:for="{{l}}" wx:for-item="item" wx:key="e" class="legend-row"><view class="legend-color" style="{{'background-color:' + item.a}}"></view><text class="legend-name">{{item.b}}</text><text class="legend-value">{{item.c}}</text><text class="legend-percent">{{item.d}}%</text></view></view></view></view><view wx:if="{{m}}" class="trend-card"><view class="trend-head"><view><text class="section-title">支出趋势</text><text class="trend-sub">按当前月均估算（6个月）</text></view><text class="unit-label">币种：{{n}}</text></view><view class="bar-chart"><view wx:for="{{o}}" wx:for-item="bar" wx:key="d" class="bar-column"><text class="bar-value">{{bar.a}}</text><view class="bar-track"><view class="bar-fill" style="{{'height:' + bar.b}}"></view></view><text>{{bar.c}}</text></view></view></view><view wx:if="{{p}}" class="insight-card"><view class="insight-icon"><uni-icons wx:if="{{q}}" u-i="1dfe2440-2" bind:__l="__l" u-p="{{q}}"/></view><view><text class="insight-title">年度订阅可重点检查</text><text class="insight-desc">年度订阅单次扣费更高，建议至少提前 14 天确认是否继续使用。</text></view></view></view>