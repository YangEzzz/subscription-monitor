<view class="page detail-page"><view class="detail-titlebar"><button role="button" tabindex="0" class="icon-button plain" aria-label="返回" catchtap="{{b}}"><uni-icons wx:if="{{a}}" u-i="968dcd6c-0" bind:__l="__l" u-p="{{a}}"/></button><text class="page-title">订阅详情</text><view class="icon-spacer"></view></view><view class="detail-hero"><brand-logo wx:if="{{c}}" u-i="968dcd6c-1" bind:__l="__l" u-p="{{c}}"/><view class="detail-hero-copy"><text class="detail-name">{{d}}</text><text class="detail-plan">{{e}}</text></view><text class="{{['status-badge', 'large', g]}}">{{f}}</text></view><view class="detail-amount-card"><text class="detail-amount-label">{{h}}</text><text class="detail-amount">{{i}}</text><text class="detail-countdown">{{j}} · {{k}}</text></view><view class="detail-grid"><view><text>计费周期</text><text>{{l}}</text></view><view><text>付款渠道</text><text>{{m}}</text></view><view><text>分类</text><text>{{n}}</text></view><view><text>自动续费</text><text>{{o}}</text></view></view><view wx:if="{{p}}" class="trial-banner"><uni-icons wx:if="{{q}}" u-i="968dcd6c-2" bind:__l="__l" u-p="{{q}}"/><view><text>试用期截止日</text><text>{{r}}，请在此日前确认是否继续。</text></view></view><view class="detail-block"><view class="block-head"><text>提醒计划</text><text>{{s}}</text></view><view class="reminder-tags"><text wx:for="{{t}}" wx:for-item="day" wx:key="b">{{day.a}}</text></view><text class="block-note">最近提醒：{{v}}</text></view><view wx:if="{{w}}" class="detail-block"><view class="block-head"><text>续费记录</text><text>共 {{x}} 次</text></view><view class="history-list"><view wx:for="{{y}}" wx:for-item="record" wx:key="c" class="history-row"><view><text>{{record.a}}</text><text>已确认续费</text></view><text>{{record.b}}</text></view></view></view><view wx:if="{{z}}" class="detail-block"><view wx:if="{{A}}" class="text-info"><text>备注</text><text>{{B}}</text></view><view wx:if="{{C}}" class="text-info"><text>取消路径</text><text>{{D}}</text></view></view><view wx:if="{{E}}" class="{{['process-card', W && 'completed']}}"><view wx:if="{{F}}" class="renewal-result"><view class="result-icon"><uni-icons wx:if="{{G}}" u-i="968dcd6c-3" bind:__l="__l" u-p="{{G}}"/></view><view class="result-copy"><text class="section-title">本期续费已确认</text><text class="process-note">{{H}}</text><button role="button" tabindex="0" class="undo-button" bindtap="{{I}}"> 撤销本次确认 </button></view></view><view wx:elif="{{J}}"><view class="process-countdown"><uni-icons wx:if="{{K}}" u-i="968dcd6c-4" bind:__l="__l" u-p="{{K}}"/><text>距{{L}}还有 {{M}} 天</text></view><button role="button" tabindex="0" class="process-button early" bindtap="{{O}}"><uni-icons wx:if="{{N}}" u-i="968dcd6c-5" bind:__l="__l" u-p="{{N}}"/><text>提前记录续费</text></button></view><view wx:else><text class="section-title">{{P}}</text><text class="process-desc">请按实际处理结果更新本期记录，本工具不会代替你向服务商取消。</text><view class="process-actions"><button role="button" tabindex="0" class="process-button success" bindtap="{{R}}"><uni-icons wx:if="{{Q}}" u-i="968dcd6c-6" bind:__l="__l" u-p="{{Q}}"/><text>确认已续费</text></button><button role="button" tabindex="0" class="process-button later" bindtap="{{T}}"><uni-icons wx:if="{{S}}" u-i="968dcd6c-7" bind:__l="__l" u-p="{{S}}"/><text>稍后处理</text></button><button role="button" tabindex="0" class="process-button cancel" bindtap="{{V}}"><uni-icons wx:if="{{U}}" u-i="968dcd6c-8" bind:__l="__l" u-p="{{U}}"/><text>已取消</text></button></view></view></view><view class="detail-bottom"><button role="button" tabindex="0" class="secondary-button manage-button" bindtap="{{Y}}"><uni-icons wx:if="{{X}}" u-i="968dcd6c-9" bind:__l="__l" u-p="{{X}}"/>管理订阅</button><button role="button" tabindex="0" class="primary-button edit-button" bindtap="{{aa}}"><uni-icons wx:if="{{Z}}" u-i="968dcd6c-10" bind:__l="__l" u-p="{{Z}}"/>编辑订阅 </button></view></view>