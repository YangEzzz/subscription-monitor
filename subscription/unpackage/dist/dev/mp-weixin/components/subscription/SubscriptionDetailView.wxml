<view class="page detail-page redesign-page redesign-ancillary flow-page"><view wx:if="{{a}}" class="flow-header"><page-header wx:if="{{c}}" bindback="{{b}}" u-i="968dcd6c-0" bind:__l="__l" u-p="{{c}}"/></view><view class="{{['detail-summary', 'card', 'hero', z]}}"><view class="detail-hero"><view class="detail-service-logo" style="{{e}}">{{d}}</view><view class="detail-hero-copy"><text class="detail-name">{{f}}</text><text class="detail-plan">{{g}}</text><text wx:if="{{h}}" class="detail-plan">{{i}}</text></view><text class="{{['status-badge', 'large', k]}}">{{j}}</text></view><view class="detail-amount-card"><text class="detail-amount-label">{{l}}</text><view class="detail-charge-row"><text class="{{['detail-amount', n && 'amount-missing']}}">{{m}}</text><view class="detail-when"><text class="detail-date num">{{o}}</text><text class="{{['due', 'num', q]}}">{{p}}</text></view></view><view wx:if="{{r}}" class="detail-cycle"><view class="cycle-track" role="progressbar" aria-label="本期进度" aria-valuenow="{{v}}" aria-valuemin="0" aria-valuemax="100"><view class="cycle-fill" style="{{'transform:' + s}}"></view><view class="cycle-marker" style="{{'left:' + t}}"></view></view><view class="cycle-labels"><text>本期 <text class="num">{{w}}</text></text><text><text class="num">{{x}}</text> {{y}}</text></view></view></view></view><view class="detail-grid card list"><view class="detail-fact"><view class="icon-tile blue"><uni-icons wx:if="{{A}}" u-i="968dcd6c-1" bind:__l="__l" u-p="{{A}}"/></view><view class="fact-copy"><text class="fact-label">计费周期</text><text class="{{['fact-value', C && 'num']}}">{{B}}</text></view></view><view class="detail-fact"><view class="icon-tile green"><uni-icons wx:if="{{D}}" u-i="968dcd6c-2" bind:__l="__l" u-p="{{D}}"/></view><view class="fact-copy"><text class="fact-label">付款渠道</text><text class="fact-value">{{E}}</text></view></view><view class="detail-fact"><view class="icon-tile violet"><uni-icons wx:if="{{F}}" u-i="968dcd6c-3" bind:__l="__l" u-p="{{F}}"/></view><view class="fact-copy"><text class="fact-label">分类</text><text class="fact-value">{{G}}</text></view></view><view class="detail-fact"><view class="icon-tile orange"><uni-icons wx:if="{{H}}" u-i="968dcd6c-4" bind:__l="__l" u-p="{{H}}"/></view><view class="fact-copy"><text class="fact-label">自动续费</text><view class="fact-value"><view class="{{['dot', 'renewal-dot', I && 'renewal-on']}}"></view><text>{{J}}</text></view></view></view></view><view wx:if="{{K}}" class="trial-banner"><uni-icons wx:if="{{L}}" u-i="968dcd6c-5" bind:__l="__l" u-p="{{L}}"/><view><text>试用期截止日</text><text><text class="num">{{M}}</text>，请在此日前确认是否继续。</text></view></view><view class="detail-block card detail-reminders"><view class="block-head"><text>提醒计划</text><view class="{{['pill', 'round', 'notification-status', O]}}"><view class="dot notification-dot"></view><text>{{N}}</text></view></view><scroll-view scroll-x show-scrollbar="{{true}}" class="detail-steps-scroll"><view class="detail-steps"><block wx:for="{{P}}" wx:for-item="day" wx:key="b"><text class="reminder-step num">{{day.a}}</text><view class="reminder-connector"></view></block><view class="reminder-goal"><view class="icon-tile orange"><uni-icons wx:if="{{Q}}" u-i="968dcd6c-6" bind:__l="__l" u-p="{{Q}}"/></view><text>{{R}}</text></view></view></scroll-view><view class="{{['detail-reminder-notice', V && 'notice-warning']}}"><view class="{{['icon-tile', T]}}"><uni-icons wx:if="{{S}}" u-i="968dcd6c-7" bind:__l="__l" u-p="{{S}}"/></view><text class="block-note">最近提醒：<text class="reminder-message num">{{U}}</text></text></view></view><view wx:if="{{W}}" class="detail-block card"><view class="block-head"><text>续费记录</text><text>共 <text class="num">{{X}}</text> 次</text></view><view class="history-list"><view wx:for="{{Y}}" wx:for-item="record" wx:key="c" class="history-row"><view><text>{{record.a}}</text><text>已确认续费</text></view><text>{{record.b}}</text></view></view></view><view wx:if="{{Z}}" class="detail-block card"><view wx:if="{{aa}}" class="text-info"><text>备注</text><text>{{ab}}</text></view><view wx:if="{{ac}}" class="text-info"><text>取消路径</text><text>{{ad}}</text></view></view><view wx:if="{{ae}}" class="{{['process-card', 'card', ax && 'completed']}}"><view wx:if="{{af}}" class="renewal-result"><view class="result-icon"><uni-icons wx:if="{{ag}}" u-i="968dcd6c-8" bind:__l="__l" u-p="{{ag}}"/></view><view class="result-copy"><text class="section-title">本期续费已确认</text><text class="process-note num">{{ah}}</text><button hover-class="is-pressed" role="button" tabindex="0" class="undo-button" bindtap="{{ai}}"> 撤销本次确认 </button></view></view><view wx:elif="{{aj}}"><view class="process-countdown"><uni-icons wx:if="{{ak}}" u-i="968dcd6c-9" bind:__l="__l" u-p="{{ak}}"/><text>距{{al}}还有 <text class="num">{{am}}</text> 天</text></view><button hover-class="is-pressed" role="button" tabindex="0" class="process-button early" bindtap="{{ao}}"><uni-icons wx:if="{{an}}" u-i="968dcd6c-10" bind:__l="__l" u-p="{{an}}"/><text>提前记录续费</text></button></view><view wx:else><text class="section-title"><text wx:for="{{ap}}" wx:for-item="part" wx:key="b" class="{{[part.c && 'num process-title-number']}}">{{part.a}}</text></text><text class="process-desc">请按实际处理结果更新本期记录，本工具不会代替你向服务商取消。</text><view class="process-actions"><button hover-class="is-pressed" role="button" tabindex="0" class="process-button success" bindtap="{{ar}}"><uni-icons wx:if="{{aq}}" u-i="968dcd6c-11" bind:__l="__l" u-p="{{aq}}"/><text>确认已续费</text></button><button hover-class="is-pressed" role="button" tabindex="0" class="process-button later" bindtap="{{at}}"><uni-icons wx:if="{{as}}" u-i="968dcd6c-12" bind:__l="__l" u-p="{{as}}"/><text>稍后处理</text></button><button hover-class="is-pressed" role="button" tabindex="0" class="process-button cancel" bindtap="{{aw}}"><uni-icons wx:if="{{av}}" u-i="968dcd6c-13" bind:__l="__l" u-p="{{av}}"/><text>已取消</text></button></view></view></view><view class="detail-bottom flow-actionbar"><button hover-class="is-pressed" role="button" tabindex="0" class="secondary-button manage-button" bindtap="{{az}}"><uni-icons wx:if="{{ay}}" u-i="968dcd6c-14" bind:__l="__l" u-p="{{ay}}"/>管理订阅</button><button hover-class="is-pressed" role="button" tabindex="0" class="primary-button edit-button" bindtap="{{aB}}"><uni-icons wx:if="{{aA}}" u-i="968dcd6c-15" bind:__l="__l" u-p="{{aA}}"/>编辑订阅 </button></view></view>