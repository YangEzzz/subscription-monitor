page {
  background: #f3f5f4;
  color: #172a22;
}
.app-shell {
  width: 100%;
  min-height: 100vh;
  background: #f3f5f4;
}
.safe-top {
  height: 20px;
  background: #f3f5f4;
}
.page-scroll {
  height: calc(100vh - 20px);
}
.page {
  box-sizing: border-box;
  min-height: calc(100vh - var(--status-bar-height));
  padding: 0 28rpx 180rpx;
  background: #f3f5f4;
}
.primary-titlebar,
.detail-titlebar {
  height: 88rpx;
  display: flex;
  align-items: center;
}
.primary-titlebar {
  box-sizing: border-box;
  padding: 0 184rpx 0 8rpx;
  justify-content: flex-start;
}
.primary-titlebar > view:first-child {
  flex: 1;
  min-width: 0;
}
.primary-titlebar > .page-title {
  transform: translateY(10rpx);
}
.detail-titlebar {
  position: relative;
  justify-content: space-between;
}
.detail-titlebar > .page-title {
  position: absolute;
  left: 50%;
  max-width: 360rpx;
  transform: translateX(-50%);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.page-title {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 750;
}
.home-lead {
  display: block;
