  color: #9b7a42;
  font-size: 18rpx;
  font-weight: 680;
  letter-spacing: 0.4rpx;
}
.membership-title {
  display: block;
  margin-top: 3rpx;
  color: #3e2b12;
  font-size: 28rpx;
  font-weight: 740;
}
.membership-entry.active .membership-title {
  color: #0d5e34;
}
.membership-desc {
  display: block;
  margin-top: 5rpx;
  color: #876a42;
  font-size: 20rpx;
  line-height: 1.35;
}
.membership-entry.active .membership-desc {
  color: #4e7060;
}
.membership-arrow {
  flex: 0 0 auto;
  margin-left: 10rpx;
}
.membership-quota {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(180, 134, 49, 0.16);
}
.membership-quota-line {
  display: flex;
  justify-content: space-between;
  color: #8a6c39;
  font-size: 19rpx;
}
.membership-progress {
  height: 10rpx;
