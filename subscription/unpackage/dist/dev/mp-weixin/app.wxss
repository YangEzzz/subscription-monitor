}
.benefit-icon-wrap {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.benefit-icon-wrap.gold {
  background: linear-gradient(135deg, #fde8b8, #faf0d4);
}
.benefit-icon-wrap.green {
  background: linear-gradient(135deg, #d8f2e5, #e8f7ee);
}
.benefit-copy {
  flex: 1;
  min-width: 0;
}
.benefit-name {
  display: block;
  font-size: 26rpx;
  font-weight: 660;
