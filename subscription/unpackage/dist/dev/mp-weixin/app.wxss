}
.status-card-icon-wrap {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: #eaf6ef;
  display: flex;
  align-items: center;
  justify-content: center;
}
