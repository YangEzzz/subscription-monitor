    justify-content: center;
    position: relative;
}
.uni-divider__content{
    font-size: 28rpx;
    color: #999;
    padding: 0 20rpx;
    position: relative;
    z-index: 101;
    background: #F4F5F6;
}
.uni-divider__line{
    background-color: #CCCCCC;
    height: 1px;
    width: 100%;
    position: absolute;
    z-index: 100;
    top: 50%;
    left: 0;
    transform: translateY(50%);
}
