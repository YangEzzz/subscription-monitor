.status-badge.trial {
  color: #a86210;
  background: #fff0dd;
}
.trial-banner {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: flex-start;
  border: 1rpx solid #f1dfc7;
  border-radius: 14rpx;
  background: #fff8ef;
  color: #825115;
}
.trial-banner > uni-icons {
  flex: 0 0 auto;
  margin: 2rpx 12rpx 0 0;
}
.trial-banner text:first-child {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
}
.trial-banner text:last-child {
  display: block;
  margin-top: 5rpx;
  color: #9b7950;
  font-size: 20rpx;
  line-height: 1.45;
}
.form-card .money-input input[type=number] {
  width: 160rpx;
}
.process-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.process-actions .process-button {
  width: 100%;
  min-height: 82rpx;
  margin: 0;
  flex-direction: row;
  gap: 8rpx;
}
.process-actions .process-button text {
  margin-top: 0;
}
.process-actions .process-button.success {
  grid-column: 1/-1;
}
@media screen and (min-width: 768px) {
.app-shell {
    max-width: 750rpx;
    margin: 0 auto;
    box-shadow: 0 0 48px rgba(20, 40, 27, 0.09);
}
.float-add {
    right: calc((100vw - 750rpx) / 2 + 32rpx);
}
}