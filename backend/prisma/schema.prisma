generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  active
  trial
  pending
  paused
  cancelled
  archived
}

enum BillingCycle {
  weekly
  monthly
  quarterly
  semiannual
  yearly
  custom_days
  one_off
}

enum SubscriptionCategory {
  video
  music
  cloud
  ai
  productivity
  reading
  other
}

enum PaymentMethod {
  wechat
  alipay
  app_store
  card
  official_site
  other
}

enum MembershipStatus {
  free
  active
}

enum MembershipPlan {
  free
  member
}

model AppUser {
  isTest Boolean @default(false) @map("is_test")
  testNote String? @map("test_note") @db.VarChar(200)
  testUpdatedBy String? @map("test_updated_by") @db.VarChar(80)
  testUpdatedAt DateTime? @map("test_updated_at") @db.Timestamptz(3)
  labelEvents AdminUserLabelEvent[]
  membershipGrants AdminMembershipGrant[]
  dailyActivity UserDailyActivity[]
  authEvents AuthEvent[]
  lastAccessIp String? @map("last_access_ip") @db.VarChar(45)
  lastAccessAt DateTime? @map("last_access_at") @db.Timestamptz(3)
  id            String         @id @db.VarChar(128)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions Subscription[]
  settings      UserSettings?
  membership    Membership?
  membershipOrders MembershipOrder[]
  wechatAppId   String?        @map("wechat_app_id") @db.VarChar(64)
  wechatOpenId  String?        @map("wechat_open_id") @db.VarChar(128)
  wechatSessionKeyEncrypted String? @map("wechat_session_key_encrypted") @db.Text
  wechatSessionUpdatedAt DateTime? @map("wechat_session_updated_at") @db.Timestamptz(3)
  notificationGrants NotificationGrant[]
  notificationDeliveries NotificationDelivery[]

  @@unique([wechatAppId, wechatOpenId], map: "app_users_wechat_identity_key")

  @@map("app_users")
}

model Subscription {
  id                         String                 @id @db.VarChar(64)
  userId                     String                 @map("user_id") @db.VarChar(128)
  user                       AppUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String                 @db.VarChar(120)
  plan                       String?                @db.VarChar(120)
  logo                       String?                @db.VarChar(16)
  color                      String                 @default("#16834d") @db.VarChar(16)
  amount                     Decimal?               @db.Decimal(12, 2)
  currency                   String                 @default("CNY") @db.Char(3)
  cycle                      BillingCycle
  cycleValue                 Int?                   @map("cycle_value")
  anchorDay                  Int                    @map("anchor_day")
  nextBillingDate            DateTime               @map("next_billing_date") @db.Date
  payment                    PaymentMethod          @default(other)
  category                   SubscriptionCategory
  status                     SubscriptionStatus     @default(active)
  autoRenew                  Boolean                @default(true) @map("auto_renew")
  trialEndDate               DateTime?              @map("trial_end_date") @db.Date
  note                       String                 @default("") @db.VarChar(1000)
  cancelGuide                String                 @default("") @map("cancel_guide") @db.VarChar(1000)
  isDemo                     Boolean                @default(false) @map("is_demo")
  lastRenewedAt              DateTime?              @map("last_renewed_at") @db.Timestamptz(3)
  lastRenewalNextBillingDate DateTime?              @map("last_renewal_next_billing_date") @db.Date
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?              @map("deleted_at") @db.Timestamptz(3)
  reminders                  SubscriptionReminder[]
  renewalHistory             RenewalEvent[]
  notificationDeliveries     NotificationDelivery[]

  @@index([userId, deletedAt], map: "subscriptions_user_deleted_idx")
  @@index([userId, nextBillingDate], map: "subscriptions_user_billing_idx")
  @@index([userId, category], map: "subscriptions_user_category_idx")
  @@index([userId, status], map: "subscriptions_user_status_idx")
  @@map("subscriptions")
}

model NotificationGrant {
  id         String   @id @db.VarChar(64)
  userId     String   @map("user_id") @db.VarChar(128)
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId  String   @map("request_id") @db.VarChar(64)
  templateId String   @map("template_id") @db.VarChar(128)
  result     String   @db.VarChar(16)
  status     String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, requestId], map: "notification_grants_request_key")
  @@index([userId, templateId, status], map: "notification_grants_available_idx")
  @@map("notification_grants")
}

model NotificationDelivery {
  id               String       @id @db.VarChar(64)
  userId           String       @map("user_id") @db.VarChar(128)
  user             AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String       @map("subscription_id") @db.VarChar(64)
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionName String       @map("subscription_name") @db.VarChar(120)
  billingDate      DateTime     @map("billing_date") @db.Date
  offset           Int
  templateId       String       @map("template_id") @db.VarChar(128)
  grantId          String       @map("grant_id") @db.VarChar(64)
  status           String       @db.VarChar(16)
  attempts         Int          @default(1)
  errorCode        String?      @map("error_code") @db.VarChar(64)
  nextAttemptAt    DateTime?    @map("next_attempt_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, subscriptionId, billingDate, offset], map: "notification_deliveries_period_key")
  @@index([userId, createdAt], map: "notification_deliveries_user_idx")
  @@index([status, updatedAt], map: "notification_deliveries_recovery_idx")
  @@map("notification_deliveries")
}

model SubscriptionReminder {
  subscriptionId String       @map("subscription_id") @db.VarChar(64)
  offsetDays     Int          @map("offset_days")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, offsetDays])
  @@map("subscription_reminders")
}

model RenewalEvent {
  id                      String             @id @db.VarChar(64)
  subscriptionId          String             @map("subscription_id") @db.VarChar(64)
  subscription            Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  renewedAt               DateTime           @map("renewed_at") @db.Timestamptz(3)
  previousStatus          SubscriptionStatus @map("previous_status")
  previousNextBillingDate DateTime           @map("previous_next_billing_date") @db.Date
  nextBillingDate         DateTime           @map("next_billing_date") @db.Date
  amount                  Decimal?           @db.Decimal(12, 2)
  currency                String             @db.Char(3)

  @@index([subscriptionId, renewedAt], map: "renewal_events_subscription_time_idx")
  @@unique([subscriptionId, previousNextBillingDate], map: "renewal_events_period_key")
  @@map("renewal_events")
}

model UserSettings {
  userId                    String   @id @map("user_id") @db.VarChar(128)
  user                      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountVisible             Boolean  @default(true) @map("amount_visible")
  notificationEnabled       Boolean  @default(false) @map("notification_enabled")
  notificationAuthorization String[] @default([]) @map("notification_authorization")
  weeklySummary             Boolean  @default(true) @map("weekly_summary")
  defaultCurrency           String   @default("CNY") @map("default_currency") @db.Char(3)
  defaultReminders          Int[]    @default([7, 3, 1]) @map("default_reminders")
  reminderTime              String   @default("09:00") @map("reminder_time") @db.VarChar(5)
  timezone                  String   @default("Asia/Shanghai") @db.VarChar(64)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_settings")
}

model AdminMembershipGrant {
  action String @default("grant") @db.VarChar(16)
  previousMembership Json? @map("previous_membership")
  id String @id @db.Uuid
  userId String @map("user_id") @db.VarChar(128)
  user AppUser @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  note String @db.VarChar(200)
  operator String @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId,createdAt],map:"admin_membership_grants_user_idx")
  @@map("admin_membership_grants")
}

model Membership {
  sourceOrderId String? @map("source_order_id") @db.VarChar(64)
  userId    String           @id @map("user_id") @db.VarChar(128)
  user      AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String @default("legacy") @db.VarChar(24)
  status    MembershipStatus @default(free)
  plan      MembershipPlan   @default(free)
  startedAt DateTime?        @map("started_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("memberships")
}

model MembershipOrder {
  refundReceipts PaymentRefundReceipt[]
  refund MembershipRefund?
  paymentRequestedAt DateTime? @map("payment_requested_at") @db.Timestamptz(3)
  deliveryConfirmedAt DateTime? @map("delivery_confirmed_at") @db.Timestamptz(3)
  transactionId String? @unique @map("transaction_id") @db.VarChar(64)
  id String @id @db.VarChar(64)
  userId String @map("user_id") @db.VarChar(128)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String @map("request_id") @db.VarChar(80)
  productId String @map("product_id") @db.VarChar(32)
  productName String @map("product_name") @db.VarChar(80)
  amount Int
  currency String @db.Char(3)
  channel String @db.VarChar(24)
  status String @db.VarChar(24)
  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([userId, requestId], map: "membership_orders_user_request_key")
  @@index([userId, createdAt], map: "membership_orders_user_created_idx")
  @@index([channel, status, id], map: "membership_orders_reconcile_idx")
  @@map("membership_orders")
}

model AuthEvent {
  id String @id @db.Uuid
  userId String @map("user_id") @db.VarChar(128)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  action String @db.VarChar(16)
  appId String @map("app_id") @db.VarChar(64)
  clientIp String? @map("client_ip") @db.VarChar(45)
  peerIp String? @map("peer_ip") @db.VarChar(45)
  requestId String @map("request_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "auth_events_created_at_id_idx")
  @@index([userId, createdAt(sort: Desc)], map: "auth_events_user_id_created_at_idx")
  @@map("auth_events")
}

model UserDailyActivity {
  userId String @map("user_id") @db.VarChar(128)
  activityDate DateTime @map("activity_date") @db.Date
  firstSeenAt DateTime @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, activityDate])
  @@index([activityDate], map: "user_daily_activity_date_idx")
  @@map("user_daily_activity")
}

model MembershipRefund {
  orderId String @id @map("order_id") @db.VarChar(64)
  order MembershipOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  refundId String @unique @map("refund_id") @db.VarChar(32)
  amount Int
  status String @db.VarChar(24)
  reason String @db.VarChar(200)
  reasonCode String @map("reason_code") @db.VarChar(1)
  operator String @db.VarChar(80)
  errorCode String? @map("error_code") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  @@index([status,orderId],map:"membership_refunds_status_order_idx")
  @@map("membership_refunds")
}

model AdminUserLabelEvent {
 id String @id @db.Uuid
 userId String @map("user_id") @db.VarChar(128)
 user AppUser @relation(fields:[userId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 previousIsTest Boolean @map("previous_is_test")
 isTest Boolean @map("is_test")
 note String @db.VarChar(200)
 operator String @db.VarChar(80)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@index([userId,createdAt],map:"admin_user_label_events_user_idx")
 @@map("admin_user_label_events")
}
model PaymentRefundReceipt {
 id String @id @db.VarChar(160)
 orderId String @map("order_id") @db.VarChar(64)
 order MembershipOrder @relation(fields:[orderId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 amount Int
 confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
 observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(3)
 source String @db.VarChar(24)
 timeSource String @map("time_source") @db.VarChar(24)
 @@index([orderId],map:"payment_refund_receipts_order_idx")
 @@index([confirmedAt],map:"payment_refund_receipts_confirmed_idx")
 @@map("payment_refund_receipts")
}
