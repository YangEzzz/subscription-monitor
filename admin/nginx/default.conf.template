map $uri $admin_cache_control {
    ~^/assets/ "public, max-age=31536000, immutable";
    ~^/api/ "no-store";
    default "no-cache";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Cache-Control $admin_cache_control always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        if ($http_sec_fetch_site = 'cross-site') { return 403; }
        limit_except GET { deny all; }
        proxy_pass http://${ADMIN_API_UPSTREAM}/;
        proxy_http_version 1.1;
        # Trusted internal gateway to the loopback-only read API.
        proxy_set_header Host localhost:3002;
        proxy_set_header Origin '';
        proxy_set_header X-Forwarded-For '';
        proxy_set_header Forwarded '';
        proxy_set_header Authorization '';
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
