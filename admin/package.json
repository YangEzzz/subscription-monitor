{
  "name": "subscription-monitor-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "ui:add": "shadcn-vue add",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts playwright.config.ts tsconfig.json tests README.md",
    "format:check": "prettier --check src index.html vite.config.ts playwright.config.ts tsconfig.json tests README.md",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.3",
    "prettier": "^3.8.1",
    "shadcn-vue": "2.8.2",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.9.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "pnpm@9.13.2"
}
